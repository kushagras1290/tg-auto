# --- Google Indexing API -----------------------------------------------
# Requires a Google Cloud service account with the Indexing API enabled,
# added as an Owner user on the truegritin.com property in Search Console
# (Settings > Users and permissions > Add user > paste the service account's
# client_email > role: Owner). See README.md for the full walkthrough.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/google-service-account.json

# Google enforces a default publish quota of 200 URLs/day per property.
# Kept below that by default so a partial run never triggers a 429.
GOOGLE_DAILY_QUOTA=180

# --- IndexNow (Bing / Yandex / Seznam.cz / Naver) -----------------------
# Any 8-64 char hex/alnum string you generate yourself. A file named
# "<key>.txt" containing just the key must be hosted at
# https://<SITE_HOST>/<key>.txt before submissions will be accepted.
INDEXNOW_KEY=
SITE_HOST=www.truegritin.com

# --- Shared ---------------------------------------------------------------
# Where run logs (JSON lines) and the submission ledger are written.
STATE_DIR=./state
LOG_DIR=./logs
